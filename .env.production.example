# Copy to .env (never commit it) and fill in the values.
FLASK_ENV=production
PORT=5008
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL database "globalhelpdesk"
DATABASE_URL=postgresql+psycopg2://helpdesk_app:YOUR_PASSWORD@localhost:5432/globalhelpdesk
# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
# First super admin on an empty database
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change-me-now
# Optional: receives 500-error emails
ERROR_NOTIFICATION_EMAIL=
